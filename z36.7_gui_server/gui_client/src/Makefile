####### Compile

main.o: main.cpp mainwindow.h \
		../sources/Database.h \
		../sources/User.h \
		../sources/sha1.h \
		../sources/Message.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

mainwindow.o: mainwindow.cpp mainwindow.h \
		../sources/Database.h \
		../sources/User.h \
		../sources/sha1.h \
		../sources/Message.h \
		ui_mainwindow.h \
		startscreen.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o mainwindow.cpp

startscreen.o: startscreen.cpp startscreen.h \
		../sources/Database.h \
		../sources/User.h \
		../sources/sha1.h \
		../sources/Message.h \
		ui_startscreen.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o startscreen.o startscreen.cpp

loginform.o: loginform.cpp loginform.h \
		../sources/Database.h \
		../sources/User.h \
		../sources/sha1.h \
		../sources/Message.h \
		ui_loginform.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o loginform.o loginform.cpp

registrationform.o: registrationform.cpp registrationform.h \
		../sources/Database.h \
		../sources/User.h \
		../sources/sha1.h \
		../sources/Message.h \
		ui_registrationform.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o registrationform.o registrationform.cpp

